# Secrets : ne jamais versionner
# Tout fichier dont le nom commence par .env (.env, .env.txt, .env - Copie, .env.local…),
# dans n'importe quel dossier, sauf le modèle vide .env.example.
.env*
!.env.example
*.dev.vars*
!.dev.vars.example
.wrangler/
tools/releves/

# Divers
node_modules/
.DS_Store

# Cache Python (script d'essai du pilotage local)
__pycache__/

# Sortie de construction du site public (phase 3a)
dist/

# Coque Android (phase 3b) : sorties de construction, chemin local du SDK
android/**/build/
android/.gradle/
android/local.properties

# Clés de signature de l'APK : secrets du PC, jamais dans le dépôt
*.jks
*.keystore
*.p12
*.pfx
*.pem
keystore.properties
signing.properties
