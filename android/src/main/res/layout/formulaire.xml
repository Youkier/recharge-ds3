<?xml version="1.0" encoding="utf-8"?>
<!-- Écran natif de saisie : vues de la plateforme seulement (pas d'AppCompat ni de Material). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/titre_cle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titre_cle"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/explication_cle"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:labelFor="@+id/champ_id"
            android:text="@string/libelle_id"
            android:textColor="?android:attr/textColorPrimary" />

        <EditText
            android:id="@+id/champ_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/champ"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions|textVisiblePassword"
            android:maxLength="64"
            android:minHeight="48dp"
            android:textColor="?android:attr/textColorPrimary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@+id/champ_cle"
            android:text="@string/libelle_cle"
            android:textColor="?android:attr/textColorPrimary" />

        <EditText
            android:id="@+id/champ_cle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/champ"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions|textVisiblePassword"
            android:maxLength="16"
            android:minHeight="48dp"
            android:textColor="?android:attr/textColorPrimary" />

        <TextView
            android:id="@+id/texte_erreur"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/erreur" />

        <Button
            android:id="@+id/bouton_enregistrer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bouton"
            android:minHeight="48dp"
            android:text="@string/enregistrer"
            android:textColor="#ffffff" />

        <Button
            android:id="@+id/bouton_retour"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/retour"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
