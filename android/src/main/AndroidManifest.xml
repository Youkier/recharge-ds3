<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET : ouvrir des sockets TCP (le pont, vers le câble sur le Wi-Fi de la maison) ; aucune requête web n'est faite.
         ACCESS_NETWORK_STATE : trouver le réseau Wi-Fi et son adresse (ConnectivityManager). Rien d'autre :
         ni ACCESS_WIFI_STATE, ni ACCESS_LOCAL_NETWORK (targetSdk 36, décision du 2026-11-18), ni localisation. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Attente en arrière-plan (« Programmer » avant le Wi-Fi ou le câble, décisions du 2026-11-21 ; essai E0 réussi en CI
         sur API 35 et 36). Source : developer.android.com/develop/background-work/services/fgs/service-types
         (« Connected device », relevé le 2026-11-21) : type `connectedDevice` ; FOREGROUND_SERVICE +
         FOREGROUND_SERVICE_CONNECTED_DEVICE ; prérequis : au moins une de CHANGE_NETWORK_STATE, CHANGE_WIFI_STATE,
         CHANGE_WIFI_MULTICAST_STATE, NFC, TRANSMIT_IR (ici CHANGE_NETWORK_STATE, normale, sans demande ; l'appli ne change
         aucun réglage réseau). WAKE_LOCK : verrou de réveil partiel borné (16 min) pendant l'attente.
         POST_NOTIFICATIONS : permission d'exécution, demandée par la page avant la première attente ; sans elle, l'attente
         tourne quand même (E3 : le service pilote), seul le résultat n'est montré qu'à la réouverture de l'appli.
         Interdits (vérifiés par la CI) : RECEIVE_BOOT_COMPLETED, SCHEDULE_EXACT_ALARM, USE_EXACT_ALARM : rien ne démarre
         sans un geste. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:icon="@mipmap/ic_lanceur"
        android:roundIcon="@mipmap/ic_lanceur"
        android:label="@string/nom_appli"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/regles_extraction"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.Coque">

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode|keyboardHidden|density"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Non exporté : seuls l'appli et sa propre notification (« Annuler », PendingIntent explicite et immuable) le
             démarrent ; START_NOT_STICKY, 15 min au plus. -->
        <service
            android:name=".AttenteWifi"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
