<?xml version="1.0" encoding="utf-8"?>
<!-- Version de MISE AU POINT seulement (fusionné par AGP dans l'APK debug, jamais dans l'APK publié) : essai de faisabilité
     E0 de l'attente en arrière-plan (décision du 2026-11-21). La version publiée ne change pas tant que E0 n'a pas réussi.

     Source : developer.android.com/develop/background-work/services/fgs/service-types (« Connected device », relevé le
     2026-11-21) : type `connectedDevice` ; FOREGROUND_SERVICE + FOREGROUND_SERVICE_CONNECTED_DEVICE ; prérequis : au moins
     une de CHANGE_NETWORK_STATE, CHANGE_WIFI_STATE, CHANGE_WIFI_MULTICAST_STATE, NFC, TRANSMIT_IR (ici CHANGE_NETWORK_STATE,
     normale, sans demande ; l'appli ne change aucun réglage réseau).
     WAKE_LOCK : verrou de réveil partiel borné (16 min) pendant l'attente.
     POST_NOTIFICATIONS : permission d'exécution (API 33+) ; sans elle le service tourne quand même, sa notification n'est
     simplement pas affichée. Accordée en CI par `pm grant`.
     Interdits (vérifiés par la CI) : RECEIVE_BOOT_COMPLETED, SCHEDULE_EXACT_ALARM : rien ne démarre sans un geste. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name=".AttenteWifi"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
