# Copier ce fichier en tools/.env puis remplir les valeurs (tools/.env est ignoré par git).
# Ne jamais coller ces valeurs dans une conversation.
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_DEVICE_ID=
TUYA_ENDPOINT=https://openapi.tuyaeu.com
# Test du pilotage local (tools/tuya-local-test.py). TUYA_LOCAL_KEY est posée par
# `node tools/tuya-probe.mjs cle-locale` ; IP et version seulement si le scan échoue.
TUYA_LOCAL_KEY=
TUYA_LOCAL_IP=
TUYA_LOCAL_VERSION=
